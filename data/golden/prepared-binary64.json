    {
      "id": "nrz-cas",
      "kind": "nrz-cas-enclosure",
      "tool": "nrz-cas enclosure",
      "revision": "405d8d5",
      "precision_bits": 160,
      "argument": "Exact CAS rational enclosures with checked Taylor, rational-inclusion, saturating and positive-power schemas. Original claims independently replayed. This route does not use mpmath outputs."
    },
    {
      "id": "mpmath-iv",
      "kind": "mpmath-interval",
      "tool": "mpmath interval arithmetic",
      "revision": "1.3.0",
      "precision_decimal_digits": 150,
      "argument": "Interval inputs are exact rational divisions. libmpi exp/log/sqrt use floor/ceiling primitives; arithmetic is outward. expm1 uses the interval cancellation-sensitive form, and tanh uses -expm1(-2*x)/(2+expm1(-2*x)). Zero is exact. Independent of nrz output; the near-zero sample uses the inspected interval path."
    }
  ],
